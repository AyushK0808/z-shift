---
config:
  flowchart:
    rankSpacing: 28
    nodeSpacing: 18
---
flowchart LR
  SRC["Inputs<br/>images · video<br/>synchronized views"]

  subgraph S1["1  Media ingestion"]
    direction TB
    ING["Ingestion service<br/>classify · sample<br/>normalize · synchronize"]
    BUF[("Live frame buffer")]
    ING --> BUF
  end

  SCHEMA[("Spatial schema<br/>frames · timing · intrinsics")]

  subgraph S2["2  Reconstruction"]
    direction TB
    REC["Reconstruction<br/>budget · pairing<br/>MASt3R · TSDF<br/>point-map fallback"]
    CACHE[("Alignment cache")]
    RUN[("Run manifest")]
    REC --> CACHE
    REC -.-> RUN
  end

  GEO[("Geometry artifacts<br/>mesh · point cloud")]

  subgraph S3["3  Refinement"]
    direction TB
    REF["Refinement<br/>filter · fill · smooth<br/>color · validate"]
    RMAN[("Refinement manifest")]
    REF -.-> RMAN
  end

  subgraph S4["4  Delivery"]
    direction LR
    ROUTE["Compatibility<br/>router"]
    EDIT["Editing · GLB"]
    VIEW["Viewing · PLY"]
    DENY["Reject<br/>unsupported"]
    ROUTE --> EDIT
    ROUTE --> VIEW
    ROUTE --> DENY
  end

  SRC --> ING --> SCHEMA --> REC --> GEO --> REF --> ROUTE

  classDef external fill:#e0f2fe,stroke:#334155,stroke-width:1.2px,color:#172033
  classDef ingest fill:#dbeafe,stroke:#2563eb,stroke-width:1.2px,color:#172033
  classDef recon fill:#ede9fe,stroke:#7c3aed,stroke-width:1.2px,color:#172033
  classDef refine fill:#ccfbf1,stroke:#0d9488,stroke-width:1.2px,color:#172033
  classDef deliver fill:#ffedd5,stroke:#ea580c,stroke-width:1.2px,color:#172033
  classDef store fill:#fff4cc,stroke:#b96800,stroke-width:1.3px,color:#172033
  classDef reject fill:#fee2e2,stroke:#334155,stroke-width:1.2px,color:#172033

  class SRC external
  class ING ingest
  class REC recon
  class REF refine
  class ROUTE,EDIT,VIEW deliver
  class BUF,SCHEMA,CACHE,RUN,GEO,RMAN store
  class DENY reject
