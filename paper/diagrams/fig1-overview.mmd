config:
  flowchart:
    rankSpacing: 13
    nodeSpacing: 14
---
flowchart TB
  SRC["Heterogeneous input<br/>image · folder · video<br/>synced views · live"] --> ING["Ingestion<br/>classify · normalize<br/>motion sample · sync"]
  ING --> SCH[("Unified spatial<br/>schema")]
  SCH --> JB["Job construction<br/>frame budget · pairing"]
  JB -->|"single view / live"| REJ["Rejected"]
  JB --> AL["MASt3R sparse<br/>global alignment"]
  AL --> FUS{"TSDF<br/>fusion"}
  FUS -->|"off / fails"| PMAP["Dense point map"]
  FUS -->|"success"| REF["Mesh refinement<br/>filter · fill · smooth<br/>colour transfer"]
  PMAP --> REF
  REF --> RT{"Outcomes<br/>router"}
  RT -->|"editing"| D1["GLB"]
  RT -->|"viewing"| D3["Colored PLY"]
  RT -->|"live"| REJ

  classDef src fill:#e0f2fe,stroke:#0284c7,stroke-width:1.4px,color:#0c2233
  classDef ingest fill:#dbeafe,stroke:#2563eb,stroke-width:1.4px,color:#0f172a
  classDef schema fill:#fef3c7,stroke:#d97706,stroke-width:1.6px,color:#0f172a
  classDef recon fill:#ede9fe,stroke:#7c3aed,stroke-width:1.4px,color:#0f172a
  classDef fuse fill:#f3e8ff,stroke:#9333ea,stroke-width:1.4px,color:#0f172a
  classDef refine fill:#ccfbf1,stroke:#0d9488,stroke-width:1.4px,color:#0f172a
  classDef route fill:#f1f5f9,stroke:#475569,stroke-width:1.4px,color:#0f172a
  classDef deliver fill:#ffedd5,stroke:#ea580c,stroke-width:1.4px,color:#0f172a
  classDef reject fill:#fee2e2,stroke:#dc2626,stroke-width:1.4px,color:#7f1d1d

  class SRC src
  class ING ingest
  class SCH schema
  class JB,AL recon
  class FUS,PMAP fuse
  class REF refine
  class RT route
  class D1,D3 deliver
  class REJ reject
